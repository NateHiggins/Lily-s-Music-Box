; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Orison Apartments — Building"
run/main_scene="res://scenes/building/orison_root.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameBoot="*res://scripts/game_boot.gd"
Conductor="*res://scripts/audio/conductor_clock.gd"
AcousticGraphData="*res://scripts/audio/acoustic_graph.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input_devices]

; Lets a mouse drag stand in for a thumb so the phone HUD can be driven and
; judged on a desktop. Harmless when the HUD is off: it ignores touch then.
pointing/emulate_touch_from_mouse=true

[rendering]

occlusion_culling/use_occlusion_culling=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/positional_shadow/atlas_16_bits=false
limits/opengl/max_lights_per_object=16
