; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Orison Apartments — Building"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameBoot="*res://scripts/game_boot.gd"
Conductor="*res://scripts/audio/conductor_clock.gd"
AcousticGraphData="*res://scripts/audio/acoustic_graph.gd"
RealityState="*res://scripts/game/reality_game_state.gd"
RealityCases="*res://scripts/game/reality_case_manager.gd"
RealityRules="*res://scripts/game/reality_rule_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/positional_shadow/atlas_16_bits=false
limits/opengl/max_lights_per_object=16
occlusion_culling/use_occlusion_culling=true

[audio]

; The Songbook records vocals through AudioEffectRecord, which needs
; the input device open. Godot asks the OS for the microphone the
; moment this is true, so it is also the line that makes the platform
; permission prompt appear.
driver/enable_input=true
