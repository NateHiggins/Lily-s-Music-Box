class_name OrisonV2StreetTraffic
extends Node3D
## Period traffic on V2's authored carriageway, Queens 1928-29.
## Stock and the Rule of Signal: design/V2_PERIOD_TRAFFIC_2026-10-24.md.
## Motion, schedule, T junctions and warnings: design/V2_TRAFFIC_BEHAVIOUR_2026-10-24.md.
##
## The table and the GLB are both generated by
## art/blender/scripts/build_v2_period_traffic.py; this owner only reads them.
## It is a child of the STREET_ORISON_01 instance, so every coordinate here is
## the street template frame: x along the street, +z outward from Orison.
##
## One MultiMesh per stock, shared by every vehicle of that kind, plus shared
## batches for wheels, horses, legs, seated figures and signalling arms. A
## batch with nothing on the street is hidden, so only kinds present cost draws.
##
## A street vehicle lives a whole journey: it turns in from the cross street
## at one T, drives the block under its class's acceleration and braking,
## follows whoever is ahead, stops at the far T, looks for a gap in the cross
## traffic, signals by hand and turns off. The cross streets carry a cheaper
## flow (bodies and horses only, no wheels, riders or sound) both ways, so the
## block reads as one street in a city rather than a stage.
##
## THE CROSSING STAYS A TEXTURE (design/ORISON_STREET_BRIEF.md §2): no death,
## no UI, cross anywhere. A driver who sees a person in the road brakes; one
## who sees them late brakes hard and sounds a warning. Nothing drives through
## a person. Only stepping into the side of a moving vehicle earns the shove.

const DATA := "res://data/orison_v2/exterior/street_traffic.json"
const SCHEMA := "orison.v2.street-traffic.v1"
## Walk sequence: left hind, left fore, right hind, right fore, in the table's
## leg order (fore left, fore right, hind left, hind right).
const GAIT_OFFSETS := [0.25, 0.75, 0.0, 0.5]
const SHOVE_COOLDOWN := 4.0
const VOICES := 4
## The clock is read this often (seconds); the schedule changes by the minute.
const CLOCK_PERIOD := 4.0
const PLAYER_RADIUS := 0.35
const SIGNAL_POSES := {"left": 0.0, "right": 1.05, "stop": -0.8}
## Every warning a class may sound, each a cue in game/data/audio_cues.json.
const WARNING_CUES := ["traffic.klaxon", "traffic.bulb_horn", "traffic.foot_gong",
		"traffic.whip_crack", "traffic.brake_shriek"]

var data: Dictionary = {}
var startup_failed := false
var frozen := false
## Tests may pin the schedule instead of reading the campaign clock.
var clock_override: Dictionary = {}
var _player: Node3D
var _kinds: Array = []
var _classes: Dictionary = {}
var _patterns: Dictionary = {}
var _batches: Dictionary = {}
var _materials: Dictionary = {}
var _live: Array[Dictionary] = []
var _cross: Array[Dictionary] = []
var _parked: Array[Dictionary] = []
var _rng := RandomNumberGenerator.new()
var _spawn_accum := 0.0
var _cross_accum := 0.0
var _shove_cooldown := 0.0
var _clock_accum := INF
var _now: Dictionary = {}
var _voices: Array[AudioStreamPlayer3D] = []
var _streams: Dictionary = {}
## Presented warnings, newest last, for tests and the review capture.
var warnings: Array[Dictionary] = []


static func mount(world: Node) -> OrisonV2StreetTraffic:
	var traffic := OrisonV2StreetTraffic.new()
	traffic.name = "PeriodTraffic"
	if not traffic.configure(world.player):
		traffic.free()
		return null
	var street: Node3D = world.exterior_cell.instance_node(str(traffic.data.street_instance))
	if street == null:
		traffic.free()
		return null
	street.add_child(traffic)
	return traffic if not traffic.startup_failed else null


static func load_table(path := DATA) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var source: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if source is not Dictionary or source.get("schema") != SCHEMA \
			or source.get("frame") != "ORISON_FRONT_DOOR_THRESHOLD":
		return {}
	for key: String in ["site", "timing", "finishes", "kinds", "parked", "horse_coats", "stock",
			"street_instance", "classes", "schedule", "junctions", "lod"]:
		if not source.has(key):
			return {}
	# Finishes are records; index them by id once.
	var finishes := {}
	for finish: Dictionary in source.finishes:
		finishes[str(finish.id)] = finish
	source.finishes = finishes
	return source


func configure(player: Node3D, seed := -1) -> bool:
	if is_inside_tree():
		return false
	data = load_table()
	if data.is_empty():
		return false
	_player = player
	if seed >= 0:
		_rng.seed = seed
	else:
		_rng.randomize()
	_kinds = data.kinds
	for klass: Dictionary in data.classes:
		for key: String in ["acceleration", "service_brake", "panic_brake", "reaction", "warning", "brake"]:
			if not klass.has(key):
				return false
		if str(klass.warning) not in WARNING_CUES or (str(klass.brake) != "" and str(klass.brake) not in WARNING_CUES):
			return false
		_classes[str(klass.id)] = klass
	for pattern: Dictionary in data.schedule.patterns:
		if (data.schedule.weekday as Array).size() != 7 or (pattern.hours as Array).size() != 24 or (pattern.months as Array).size() != 12:
			return false
		_patterns[str(pattern.id)] = pattern
	for kind: Dictionary in _kinds:
		if not _classes.has(str(kind["class"])) or not _patterns.has(str(kind.pattern)):
			return false
	return true


func _ready() -> void:
	if data.is_empty():
		startup_failed = true
		push_error("V2 street traffic table is invalid")
		return
	var meshes := _stock_meshes()
	if meshes.is_empty():
		startup_failed = true
		push_error("V2 period traffic stock is missing")
		return
	var vehicles := int(data.timing.max_vehicles)
	var crowd: int = vehicles + int(data.lod.max_cross_vehicles) + (data.parked as Array).size()
	var stocks := {}
	for kind: Dictionary in _kinds:
		stocks[str(kind.stock)] = true
	for parked: Dictionary in data.parked:
		stocks[str(parked.stock)] = true
	for stock: String in stocks:
		_add_batch(stock, meshes, crowd)
	for wheel: String in ["wheel_wagon", "wheel_artillery", "wheel_wire", "wheel_disc", "wheel_solid"]:
		_add_batch(wheel, meshes, (vehicles + data.parked.size()) * 6)
	_add_batch("horse_body", meshes, crowd)
	_add_batch("horse_leg", meshes, crowd * 4)
	_add_batch("figure", meshes, vehicles * 2)
	_add_batch("signal_arm", meshes, vehicles)
	if startup_failed:
		return
	for parked: Dictionary in data.parked:
		_park(parked)
	_streams = {"motor": StreetTraffic._forge(2.4, false),
			"heavy": StreetTraffic._forge(2.4, false),
			"hooves": StreetTraffic._forge(2.0, true)}
	for i in VOICES:
		var voice := AudioStreamPlayer3D.new()
		voice.bus = "World"
		voice.unit_size = 8.0
		voice.max_distance = 40.0
		voice.volume_db = -13.0
		voice.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(voice)
		_voices.append(voice)
	# Start with a city already in motion rather than an empty road filling.
	for i in int(float(data.timing.warm_start_seconds) * 10.0):
		_step(0.1)
	warnings.clear()
	_write_instances()


func _process(delta: float) -> void:
	if startup_failed or frozen:
		return
	_step(delta)
	_write_instances()
	_voice_nearest()
	_check_shove()


func _step(delta: float) -> void:
	_shove_cooldown = maxf(0.0, _shove_cooldown - delta)
	_clock_accum += delta
	if _clock_accum >= CLOCK_PERIOD:
		_clock_accum = 0.0
		_read_clock()
	_advance(delta)
	_advance_cross(delta)
	_spawn(delta)
	_spawn_cross(delta)


## The stock GLB carries one mesh per (stock, finish). Each stock becomes one
## ArrayMesh whose surfaces keep their catalogue finish, so a MultiMesh draws
## the whole vehicle with one call per substance. The street lamps share it.
func _stock_meshes() -> Dictionary:
	for id: String in data.finishes:
		_materials[id] = stock_material(data.finishes[id])
	return stock_meshes(str(data.stock), _materials)


static func stock_meshes(path: String, materials: Dictionary) -> Dictionary:
	var packed := load(path) as PackedScene
	if packed == null:
		return {}
	var root := packed.instantiate()
	var result := {}
	for node: Node in root.find_children("*", "MeshInstance3D", true, false):
		var parts := str(node.name).split("__")
		if parts.size() != 2 or not materials.has(parts[1]):
			continue
		var source: Mesh = (node as MeshInstance3D).mesh
		if not result.has(parts[0]):
			result[parts[0]] = ArrayMesh.new()
		var mesh: ArrayMesh = result[parts[0]]
		for surface in source.get_surface_count():
			mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, source.surface_get_arrays(surface))
			mesh.surface_set_material(mesh.get_surface_count() - 1, materials[parts[1]])
	root.free()
	return result


static func stock_material(finish: Dictionary) -> StandardMaterial3D:
	var key := str(finish.catalog_key)
	assert(MatLib.SETS.has(key), "Unknown street stock finish: " + key)
	var mat := MatLib.get_mat(key).duplicate() as StandardMaterial3D
	mat.uv1_triplanar = false
	mat.uv2_triplanar = false
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	mat.normal_scale = float(finish.normal)
	mat.roughness = float(finish.roughness)
	var tint: Array = finish.tint
	if bool(finish.get("paint", false)):
		# The per-vehicle colour arrives as instance colour; divide out the
		# map's own mean so the palette is the colour that reaches the eye.
		var mean: Array = finish.albedo_mean
		mat.albedo_color = Color(1.0 / maxf(float(mean[0]), 0.15),
				1.0 / maxf(float(mean[1]), 0.15), 1.0 / maxf(float(mean[2]), 0.15))
		mat.vertex_color_use_as_albedo = true
	else:
		mat.albedo_color = Color(tint[0], tint[1], tint[2], tint[3])
	if finish.has("emission"):
		var glow: Array = finish.emission
		mat.emission_enabled = true
		mat.emission = Color(glow[0], glow[1], glow[2])
		mat.emission_energy_multiplier = float(glow[3])
		mat.set_meta("lamp_energy", float(glow[3]))
	mat.set_meta("v2_surface_stock", key)
	return mat


func _add_batch(stock: String, meshes: Dictionary, count: int) -> void:
	if not meshes.has(stock):
		startup_failed = true
		push_error("V2 period traffic stock lacks " + stock)
		return
	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.use_colors = true
	multimesh.mesh = meshes[stock]
	multimesh.instance_count = count
	multimesh.visible_instance_count = 0
	var node := MultiMeshInstance3D.new()
	node.name = "Traffic_" + stock
	node.multimesh = multimesh
	# Moving casters on the street station are the cost the brief refuses.
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	node.visible = false
	add_child(node)
	_batches[stock] = node


func _park(parked: Dictionary) -> void:
	var record := parked.duplicate()
	var yaw := deg_to_rad(float(parked.yaw_degrees))
	record.px = float(parked.x)
	record.pz = float(parked.z)
	record.yaw = yaw
	record.paint = Color(1, 1, 1)
	record.travel = 0.0
	_parked.append(record)
	# Parked stock keeps an honest collision box; moving traffic has none.
	var body := StaticBody3D.new()
	body.name = "Parked_" + str(parked.stock)
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	var extent: Array = parked.extent
	box.size = Vector3(float(extent[1]) - float(extent[0]), 1.0, float(parked.width))
	shape.shape = box
	body.add_child(shape)
	var middle := (float(extent[0]) + float(extent[1])) * 0.5
	body.position = Vector3(record.px, float(data.site.road_y) + 0.5, record.pz) \
			+ Basis(Vector3.UP, yaw) * Vector3(middle, 0, 0)
	body.rotation.y = yaw
	add_child(body)


# ---------------------------------------------------------------- the clock

func _read_clock() -> void:
	var info: Dictionary = clock_override
	if info.is_empty():
		info = CampaignClock.new().day_info()
	if not bool(info.get("valid", true)) or not info.has("minute_of_day"):
		info = {"day": "tue", "month": 11, "day_of_month": 20, "year": 1928, "minute_of_day": 1260.0}
	_now = info
	_update_lamps()


## How much of this kind the street should see right now, before weighting.
func _kind_rate(kind: Dictionary) -> float:
	if _now.is_empty():
		_read_clock()
	var pattern: Dictionary = _patterns[str(kind.pattern)]
	var hour := int(float(_now.minute_of_day) / 60.0) % 24
	var month := clampi(int(_now.get("month", 11)), 1, 12)
	var rate: float = float(pattern.hours[hour]) * float(pattern.months[month - 1])
	if str(_now.get("day", "")) == "sun":
		rate *= float(pattern.sunday)
	for event: Dictionary in data.schedule.events:
		if _within(event) and str(kind.pattern) in event.patterns:
			rate *= float(event.multiplier)
	return rate


func _within(event: Dictionary) -> bool:
	if not _now.has("year"):
		return false
	var today := int(_now.year) * 10000 + int(_now.month) * 100 + int(_now.day_of_month)
	var first: Array = event.from
	var last: Array = event.to
	return today >= int(first[0]) * 10000 + int(first[1]) * 100 + int(first[2]) \
			and today <= int(last[0]) * 10000 + int(last[1]) * 100 + int(last[2])


func _flow_per_minute() -> float:
	var total := 0.0
	var weights := 0.0
	for kind: Dictionary in _kinds:
		total += float(kind.weight) * _kind_rate(kind)
		weights += float(kind.weight)
	var day := CampaignClock.DAY_NAMES.find(str(_now.get("day", "mon")))
	var day_factor := float(data.schedule.weekday[maxi(day, 0)])
	return float(data.schedule.flow_per_minute) * day_factor * total / maxf(weights, 0.001)


## Lamps burn dusk to dawn. 1928 drivers ran dark by day.
func _update_lamps() -> void:
	var month := clampi(int(_now.get("month", 11)), 1, 12) - 1
	var minute := float(_now.get("minute_of_day", 1260.0))
	var dusk := float(data.schedule.dusk[month])
	var dawn := float(data.schedule.dawn[month])
	var lit := 1.0
	if minute > dawn and minute < dusk:
		lit = clampf(maxf(dawn + 25.0 - minute, minute - (dusk - 25.0)) / 25.0, 0.0, 1.0)
	for id: String in ["lamp_lit", "lamp_tail", "lamp_oil"]:
		var mat: StandardMaterial3D = _materials.get(id)
		if mat != null:
			mat.emission_energy_multiplier = float(mat.get_meta("lamp_energy", 1.0)) * lit


# ---------------------------------------------------------------- journeys
# A journey is described in its own frame: p along the direction of travel on
# this street, q to the driver's right. The street frame is
# x = dir * p, z = lane_z + dir * q. Junction t sits at p = jp[t].

func _junction_p(v: Dictionary, ahead: bool) -> float:
	# Eastbound vehicles (dir +1) head for the east T and arrive from the west.
	var junctions: Dictionary = data.junctions
	var east := float(junctions.east_x)
	var west := float(junctions.west_x)
	if float(v.dir) > 0.0:
		return east if ahead else west
	return -west if ahead else -east


func _cross_half() -> float:
	return float(data.junctions.cross_half_width)


func _lane_offset() -> float:
	return float(data.junctions.cross_lane_offset)


## Where a journey stands, in its own frame, for its current phase.
func _pose(v: Dictionary) -> Array:
	var phase := str(v.phase)
	if phase == "enter":
		var s := float(v.side)
		var radius := float(v.radius)
		var pe := float(v.pe)
		var run := float(v.run)
		if run > 0.0:
			return [pe - radius, s * (radius + run), atan2(-s, 0.0)]
		var psi := float(v.arc)
		return [pe - radius * cos(psi), s * (radius - radius * sin(psi)), atan2(-s * cos(psi), sin(psi))]
	if phase == "exit":
		var s := float(v.side)
		var radius := float(v.radius)
		var ps := float(v.ps)
		var phi := float(v.arc)
		var p := ps + radius * sin(phi)
		var q := s * (radius - radius * cos(phi))
		if float(v.run) > 0.0:
			return [ps + radius, s * (radius + float(v.run)), s * PI * 0.5]
		return [p, q, s * phi]
	return [float(v.p), 0.0, 0.0]


func _world_pose(v: Dictionary) -> Array:
	var pose := _pose(v)
	var dir := float(v.dir)
	var x := dir * float(pose[0])
	var z := float(v.lane_z) + dir * float(pose[1])
	var heading := float(pose[2])
	var hx := dir * cos(heading)
	var hz := dir * sin(heading)
	return [x, z, atan2(-hz, hx)]


func _advance(delta: float) -> void:
	var kept: Array[Dictionary] = []
	for lane_west: bool in [true, false]:
		var lane: Array[Dictionary] = []
		for v in _live:
			if bool(v.lane_west) == lane_west:
				lane.append(v)
		# Front-most first: street phase by progress, those turning off first.
		lane.sort_custom(func(a, b): return _order(a) > _order(b))
		var leader: Dictionary = {}
		for v in lane:
			if _advance_one(v, leader, delta):
				kept.append(v)
			if str(v.phase) == "street" or str(v.phase) == "stop":
				leader = v
	_live = kept


func _order(v: Dictionary) -> float:
	match str(v.phase):
		"exit": return 1.0e6 + float(v.arc) + float(v.run)
		"enter": return -1.0e6 + float(v.arc) - float(v.run)
	return float(v.p)


## One vehicle, one tick. Returns false when its journey is over.
func _advance_one(v: Dictionary, leader: Dictionary, delta: float) -> bool:
	var kind: Dictionary = _kinds[int(v.kind)]
	var klass: Dictionary = _classes[str(kind["class"])]
	var phase := str(v.phase)
	if phase == "enter":
		return _advance_enter(v, kind, klass, delta)
	if phase == "exit":
		return _advance_exit(v, kind, klass, delta)
	var front := float(v.p) + float(kind.extent[1])
	var target := float(v.cruise)
	var limit := INF
	# Following: keep a period headway of about a second and a half.
	if not leader.is_empty():
		var leader_kind: Dictionary = _kinds[int(leader.kind)]
		var leader_back: float
		if str(leader.phase) == "exit":
			leader_back = INF
		else:
			leader_back = float(leader.p) + float(leader_kind.extent[0])
		var gap := leader_back - front - float(data.timing.following_gap_m)
		target = minf(target, maxf(0.0, minf(float(leader.speed) + gap * 0.6,
				sqrt(maxf(0.0, 2.0 * float(klass.service_brake) * gap)))))
		limit = minf(limit, leader_back - 0.6)
	# The T ahead: brake to the stop line, wait, look, then turn off.
	var stop_line := _junction_p(v, true) - _cross_half() - float(data.junctions.stop_gap_m)
	var to_line := stop_line - front
	if phase == "street" and to_line < 30.0 and str(v.hand) == "":
		v.hand = "left" if float(v.side) < 0.0 else "right"
	if phase == "street":
		target = minf(target, sqrt(maxf(0.0, 2.0 * float(klass.service_brake) * maxf(to_line, 0.0))))
		limit = minf(limit, stop_line)
		if to_line < 0.05 and float(v.speed) < 0.15:
			v.phase = "stop"
			v.wait = _rng.randf_range(0.8, 2.2)
	elif phase == "stop":
		target = 0.0
		v.wait = float(v.wait) - delta
		if float(v.wait) <= 0.0 and _junction_clear(v):
			_begin_exit(v, kind)
			return true
	# A person in the road ahead. Only the driver with a clear view reacts;
	# those queued behind another vehicle simply follow it.
	var person := _person_ahead(v, kind, front)
	if person < INF and not leader.is_empty() and str(leader.phase) != "exit" 			and float(leader.p) + float(_kinds[int(leader.kind)].extent[0]) < front + person:
		person = INF
	if person < INF:
		var service_stop := float(v.speed) * float(klass.reaction) \
				+ float(v.speed) * float(v.speed) / (2.0 * float(klass.service_brake))
			# Seen late, or within three seconds of the nose: a hard stop and a
		# warning. One scare, one warning: a driver re-arms only once the
		# person has left its path.
		if not bool(v.warned) and person < maxf(service_stop + 1.0, float(v.speed) * 3.0) \
				and float(v.speed) > 1.0:
			_alarm(v, kind, klass)
		target = minf(target, sqrt(maxf(0.0, 2.0 * float(klass.service_brake)
				* maxf(person - float(data.timing.yield_stop_m), 0.0))))
		limit = minf(limit, front + person - 0.05)
		if str(v.hand) != "left" and str(v.hand) != "right":
			v.hand = "stop"
		v.blocked = float(v.get("blocked", 0.0)) + delta
		# A long wait earns a short courtesy note, never a tirade: one after
		# the driver's patience, one more after three times it, then silence.
		var notes := int(v.notes)
		if notes < 2 and float(v.alarm) <= 0.0 \
				and float(v.blocked) > float(data.timing.patience_seconds) * (1.0 if notes == 0 else 3.0):
			_warn(v, kind, klass, 0.6)
			v.notes = notes + 1
			v.blocked = 0.0
	else:
		v.blocked = 0.0
		v.warned = false
		v.notes = 0
		if str(v.hand) == "stop":
			v.hand = ""
	v.alarm = maxf(0.0, float(v.alarm) - delta)
	# Acceleration and braking: reaction delay first, then the class's curves.
	var speed := float(v.speed)
	if target < speed:
		var panic := float(v.alarm) > 0.0
		if float(v.react) > 0.0:
			v.react = float(v.react) - delta
		else:
			var decel := float(klass.panic_brake) if panic else float(klass.service_brake)
			# Service braking can deepen toward panic when the gap demands it.
			var needed := speed * speed / (2.0 * maxf(limit - front, 0.05)) if limit < INF else 0.0
			decel = clampf(maxf(decel, needed), 0.0, float(klass.panic_brake))
			speed = maxf(target, speed - decel * delta)
	else:
		speed = minf(target, speed + float(klass.acceleration) * delta)
	var step := speed * delta
	# Nothing ever drives through what is ahead of it, a person included.
	if limit < INF:
		var room := limit - front
		if step > room:
			# Speed is what the vehicle actually covers: stopped means stopped.
			step = maxf(room, 0.0)
			speed = step / delta if delta > 0.0 else 0.0
	v.speed = speed
	v.p = float(v.p) + step
	v.travel = float(v.travel) + step
	return true


func _advance_enter(v: Dictionary, kind: Dictionary, klass: Dictionary, delta: float) -> bool:
	var speed := minf(float(v.cruise) * 0.55, float(v.speed) + float(klass.acceleration) * delta)
	if float(v.run) > 0.0:
		# Wait on the cross street until the lane mouth is clear.
		if float(v.run) < 1.0 and not _lane_mouth_clear(v, kind):
			speed = maxf(0.0, float(v.speed) - float(klass.service_brake) * delta)
			v.speed = speed
			return true
		v.run = maxf(0.0, float(v.run) - speed * delta)
	else:
		v.arc = minf(PI * 0.5, float(v.arc) + speed * delta / float(v.radius))
		if float(v.arc) >= PI * 0.5:
			v.phase = "street"
			v.p = float(v.pe)
			v.hand = ""
	v.speed = speed
	v.travel = float(v.travel) + speed * delta
	return true


func _advance_exit(v: Dictionary, kind: Dictionary, klass: Dictionary, delta: float) -> bool:
	var cap := float(v.cruise) * (0.55 if float(v.run) <= 0.0 else 1.0)
	var speed := minf(cap, float(v.speed) + float(klass.acceleration) * delta)
	if float(v.arc) < PI * 0.5:
		v.arc = minf(PI * 0.5, float(v.arc) + speed * delta / float(v.radius))
		if float(v.arc) >= PI * 0.5:
			v.hand = ""
			v.run = 0.001
	else:
		v.run = float(v.run) + speed * delta
	v.speed = speed
	v.travel = float(v.travel) + speed * delta
	return float(v.run) < float(data.junctions.exit_run_m)


func _begin_exit(v: Dictionary, kind: Dictionary) -> void:
	var s := float(v.side)
	v.phase = "exit"
	v.ps = float(v.p)
	v.arc = 0.0
	v.run = 0.0
	v.radius = _junction_p(v, true) + s * _lane_offset() - float(v.ps)
	if float(v.radius) < 2.5:
		v.radius = 2.5


func _junction_clear(v: Dictionary) -> bool:
	var x := float(v.dir) * _junction_p(v, true)
	for c in _cross:
		if absf(float(c.x) - x) < _lane_offset() + 1.0 and absf(float(c.z) - float(data.junctions.center_z)) < float(data.lod.junction_clear_m):
			return false
	for other in _live:
		if other != v and str(other.phase) == "exit" and float(other.arc) < PI * 0.5 \
				and is_equal_approx(float(other.dir), float(v.dir)):
			return false
	return true


func _lane_mouth_clear(v: Dictionary, kind: Dictionary) -> bool:
	var mouth := float(v.pe) + float(kind.extent[1])
	for other in _live:
		if other == v or bool(other.lane_west) != bool(v.lane_west):
			continue
		if str(other.phase) == "enter" and float(other.run) <= 0.0:
			return false
		if str(other.phase) == "street" or str(other.phase) == "stop":
			var other_kind: Dictionary = _kinds[int(other.kind)]
			if float(other.p) + float(other_kind.extent[0]) < mouth + float(data.timing.following_gap_m):
				return false
	return true


## Distance from the vehicle's nose to a person standing in its path, or INF.
func _person_ahead(v: Dictionary, kind: Dictionary, front: float) -> float:
	if _player == null or not is_inside_tree():
		return INF
	var here := to_local(_player.global_position)
	var site: Dictionary = data.site
	if here.z < float(site.carriageway_z[0]) - 0.3 or here.z > float(site.carriageway_z[1]) + 0.3:
		return INF
	if absf(here.z - float(v.lane_z)) > float(kind.width) * 0.5 + PLAYER_RADIUS + 0.15:
		return INF
	var ahead := float(v.dir) * here.x - PLAYER_RADIUS - front
	var lookahead := float(data.timing.yield_lookahead_m) + float(v.speed) * 1.5
	if ahead < -0.3 or ahead > lookahead:
		return INF
	return maxf(ahead, 0.0)


## Seen late: a hard stop and the period's warning, once per scare.
func _alarm(v: Dictionary, kind: Dictionary, klass: Dictionary) -> void:
	v.alarm = 2.5
	v.warned = true
	v.react = float(klass.reaction) * 0.5 if float(v.speed) > 0.0 else 0.0
	v.hand = ""
	_warn(v, kind, klass, 1.0)
	if str(klass.brake) != "" and float(v.speed) > 3.0:
		_present(StringName(str(klass.brake)), v, 1.0)


func _warn(v: Dictionary, kind: Dictionary, klass: Dictionary, strength: float) -> void:
	# Nobody on the box, nobody to shout. The riderless milk horse just stops.
	if (kind.get("signal_arm", []) as Array).is_empty():
		return
	_present(StringName(str(klass.warning)), v, strength)


func _present(cue: StringName, v: Dictionary, strength: float) -> void:
	var pose := _world_pose(v)
	var at := to_global(Vector3(float(pose[0]), 1.2, float(pose[1])))
	var presented := false
	var policy := get_node_or_null("/root/AudioPolicy")
	if policy != null and policy.has_method("present_3d"):
		presented = bool(policy.present_3d(cue, at, strength, StringName("traffic_%d" % int(v.id))))
	warnings.append({"cue": str(cue), "kind": str(_kinds[int(v.kind)].id), "presented": presented,
			"speed": float(v.speed), "vehicle": int(v.id)})


func _spawn(delta: float) -> void:
	_spawn_accum -= delta
	if _spawn_accum > 0.0:
		return
	var flow := _flow_per_minute()
	if flow <= 0.01:
		_spawn_accum = 5.0
		return
	# The gap is always coming: never longer than max_wait between arrivals
	# while the street is in use at all.
	_spawn_accum = minf(_rng.randf_range(0.5, 1.5) * 60.0 / flow, float(data.timing.max_wait))
	if _live.size() >= int(data.timing.max_vehicles):
		return
	var index := _pick()
	if index < 0:
		return
	_live.append(_journey(index, _rng.randf() < 0.5))


func _journey(index: int, lane_west: bool, at_p := NAN) -> Dictionary:
	var kind: Dictionary = _kinds[index]
	var paints: Array = kind.paint
	var paint: Array = paints[_rng.randi() % paints.size()]
	var coats: Array = data.horse_coats
	var coat: Array = coats[_rng.randi() % coats.size()]
	var speed: Array = kind.speed
	var cruise := _rng.randf_range(float(speed[0]), float(speed[1]))
	var v := {"id": _rng.randi(), "kind": index, "lane_west": lane_west, "dir": -1.0 if lane_west else 1.0,
			"lane_z": float(data.site.lane_west_z) if lane_west else float(data.site.lane_east_z),
			"cruise": cruise, "speed": cruise * 0.5, "travel": _rng.randf() * 10.0,
			"paint": _palette(Color(paint[0], paint[1], paint[2]).lerp(Color(0.5, 0.5, 0.5), _rng.randf() * 0.12)),
			"coat": _palette(Color(coat[0], coat[1], coat[2])),
			"side": -1.0 if _rng.randf() < 0.5 else 1.0, "hand": "", "alarm": 0.0, "react": 0.0, "warned": false, "notes": 0,
			"blocked": 0.0, "arc": 0.0, "run": 0.0, "radius": 4.0, "p": 0.0, "ps": 0.0, "pe": 0.0, "wait": 0.0}
	if not is_nan(at_p):
		v.phase = "street"
		v.p = at_p
		v.speed = 0.0
		return v
	v.phase = "enter"
	var behind := _junction_p(v, false)
	v.pe = behind + _cross_half() + float(data.junctions.stop_gap_m) - float(kind.extent[0])
	v.radius = maxf(2.5, float(v.pe) - (behind + float(v.side) * _lane_offset()))
	v.run = float(data.junctions.exit_run_m)
	v.hand = "right" if float(v.side) > 0.0 else "left"
	return v


func _pick() -> int:
	var rates: Array[float] = []
	var total := 0.0
	for kind: Dictionary in _kinds:
		var rate := float(kind.weight) * _kind_rate(kind)
		rates.append(rate)
		total += rate
	if total <= 0.0:
		return -1
	var roll := _rng.randf() * total
	for i in rates.size():
		roll -= rates[i]
		if roll <= 0.0:
			return i
	return rates.size() - 1


## Palettes are authored in sRGB; instance colour reaches the shader linear.
static func _palette(colour: Color) -> Color:
	return colour.srgb_to_linear()


# ---------------------------------------------------------------- cross streets
# The middle distance: both cross streets carry their own flow, both ways,
# drawn cheaply (bodies and horses, no wheels, riders, arms or voices). It
# yields to anything of ours turning at the T, and our drivers wait for it.

func _spawn_cross(delta: float) -> void:
	_cross_accum -= delta
	if _cross_accum > 0.0:
		return
	var flow := _flow_per_minute() * float(data.lod.cross_flow_scale)
	if flow <= 0.01:
		_cross_accum = 5.0
		return
	_cross_accum = _rng.randf_range(0.5, 1.5) * 60.0 / flow
	if _cross.size() >= int(data.lod.max_cross_vehicles):
		return
	var index := _pick()
	if index < 0:
		return
	var kind: Dictionary = _kinds[index]
	var east := _rng.randf() < 0.5
	var heading := 1.0 if _rng.randf() < 0.5 else -1.0
	var x := float(data.junctions.east_x if east else data.junctions.west_x)
	# Driving on the right: heading +z keeps the lane at smaller x.
	x -= heading * _lane_offset()
	var reach := float(data.lod.cross_reach_m)
	var paint: Array = kind.paint[_rng.randi() % (kind.paint as Array).size()]
	var coat: Array = data.horse_coats[_rng.randi() % (data.horse_coats as Array).size()]
	var speed: Array = kind.speed
	_cross.append({"kind": index, "x": x, "z": float(data.junctions.center_z) - heading * reach,
			"heading": heading, "speed": _rng.randf_range(float(speed[0]), float(speed[1])),
			"paint": _palette(Color(paint[0], paint[1], paint[2])), "coat": _palette(Color(coat[0], coat[1], coat[2])),
			"travel": 0.0})


func _advance_cross(delta: float) -> void:
	var kept: Array[Dictionary] = []
	var centre := float(data.junctions.center_z)
	var reach := float(data.lod.cross_reach_m)
	for c in _cross:
		var kind: Dictionary = _kinds[int(c.kind)]
		var nose := float(c.z) + float(c.heading) * float(kind.extent[1])
		var step := float(c.speed) * delta
		# Hold short of the junction box while one of ours is turning in it.
		var box_edge := centre - float(c.heading) * (float(data.site.carriageway_z[1]) - centre + 0.5)
		if float(c.heading) * (box_edge - nose) > 0.0 and float(c.heading) * (box_edge - nose) < 3.0 \
				and _junction_busy(float(c.x)):
			step = 0.0
		for other in _cross:
			if other == c or not is_equal_approx(float(other.x), float(c.x)):
				continue
			var other_kind: Dictionary = _kinds[int(other.kind)]
			var gap := float(c.heading) * ((float(other.z) + float(c.heading) * float(other_kind.extent[0])) - nose)
			if gap > -0.5 and gap < step + 2.0:
				step = maxf(0.0, gap - 2.0)
		c.z = float(c.z) + float(c.heading) * step
		c.travel = float(c.travel) + step
		if float(c.heading) * (float(c.z) - centre) < reach:
			kept.append(c)
	_cross = kept


func _junction_busy(x: float) -> bool:
	for v in _live:
		var phase := str(v.phase)
		if (phase == "exit" and float(v.arc) < PI * 0.5) or (phase == "enter" and float(v.run) <= 0.0):
			if absf(float(v.dir) * _junction_p(v, phase == "exit") - x) < 6.0:
				return true
	return false


# ---------------------------------------------------------------- drawing

func _write_instances() -> void:
	var counts := {}
	for stock: String in _batches:
		counts[stock] = 0
	var road_y := float(data.site.road_y)
	var detail := float(data.lod.detail_x)
	for v in _live:
		var pose := _world_pose(v)
		_write_vehicle(_kinds[int(v.kind)], v, counts, road_y, float(pose[0]), float(pose[1]), float(pose[2]),
				absf(float(pose[0])) <= detail)
	for p in _parked:
		_write_vehicle(p, p, counts, road_y, float(p.px), float(p.pz), float(p.yaw), true)
	for c in _cross:
		var yaw := -PI * 0.5 if float(c.heading) > 0.0 else PI * 0.5
		_write_vehicle(_kinds[int(c.kind)], c, counts, road_y, float(c.x), float(c.z), yaw, false)
	for stock: String in _batches:
		var node: MultiMeshInstance3D = _batches[stock]
		node.multimesh.visible_instance_count = int(counts[stock])
		node.visible = int(counts[stock]) > 0


func _put(stock: String, counts: Dictionary, transform_: Transform3D, colour: Color) -> void:
	var node: MultiMeshInstance3D = _batches[stock]
	var i: int = counts[stock]
	if i >= node.multimesh.instance_count:
		return
	node.multimesh.set_instance_transform(i, transform_)
	node.multimesh.set_instance_color(i, colour)
	counts[stock] = i + 1


func _write_vehicle(kind: Dictionary, v: Dictionary, counts: Dictionary, road_y: float,
		x: float, z: float, yaw: float, detailed: bool) -> void:
	var frame := Transform3D(Basis(Vector3.UP, yaw), Vector3(x, road_y, z))
	var travel := float(v.travel)
	var speed := float(v.get("speed", 0.0))
	_put(str(kind.stock), counts, frame, v.paint)
	if detailed:
		for wheel: Dictionary in kind.wheels:
			var radius := float(wheel.radius)
			var s := radius / 0.5
			var at: Array = wheel.at
			var basis := Basis(Vector3.BACK, -travel / radius).scaled(Vector3(s, s, s * float(wheel.width)))
			_put(str(wheel.stock), counts, frame * Transform3D(basis, Vector3(at[0], at[1], at[2])), Color.WHITE)
	var horse: Variant = kind.get("horse")
	if horse is Dictionary:
		# Walk below 2.2 m/s, trot above: longer stride, more swing.
		var trot := speed > 2.2
		var stride := float(data.timing.stride_m) * (1.5 if trot else 1.0)
		var swing_amp := deg_to_rad(float(data.timing.leg_swing_degrees)) * (1.3 if trot else 1.0)
		var phase := travel / stride
		var at: Array = horse.at
		var scale := float(horse.scale)
		var bob := 0.022 * sin(TAU * phase * 2.0) * minf(speed / 2.0, 1.0)
		var body := frame * Transform3D(Basis().scaled(Vector3.ONE * scale), Vector3(at[0], at[1] + bob, at[2]))
		_put("horse_body", counts, body, v.coat)
		var legs: Array = horse.legs
		for i in legs.size():
			var pivot: Array = legs[i]
			var swing := swing_amp * sin(TAU * (phase + float(GAIT_OFFSETS[i]))) * minf(speed / 0.6, 1.0)
			_put("horse_leg", counts, body * Transform3D(Basis(Vector3.BACK, swing),
					Vector3(pivot[0], pivot[1], pivot[2])), v.coat)
	if not detailed:
		return
	for seat: Array in kind.get("figures", []):
		_put("figure", counts, frame * Transform3D(Basis(), Vector3(seat[0], seat[1], seat[2])), Color.WHITE)
	var shoulder: Array = kind.get("signal_arm", [])
	var gesture := str(v.get("hand", ""))
	if not shoulder.is_empty() and SIGNAL_POSES.has(gesture):
		_put("signal_arm", counts, frame * Transform3D(Basis(Vector3.RIGHT, float(SIGNAL_POSES[gesture])),
				Vector3(shoulder[0], shoulder[1], shoulder[2])), Color.WHITE)


# ---------------------------------------------------------------- contact

func _check_shove() -> void:
	if _player == null or _shove_cooldown > 0.0 or not is_inside_tree():
		return
	var here := to_local(_player.global_position)
	for v in _live:
		if str(v.phase) != "street" or float(v.speed) < 0.6:
			continue
		var kind: Dictionary = _kinds[int(v.kind)]
		var along := float(v.dir) * here.x - float(v.p)
		if along < float(kind.extent[0]) - 0.3 or along > float(kind.extent[1]) + 0.3:
			continue
		if absf(here.z - float(v.lane_z)) > float(kind.width) * 0.5 + 0.3:
			continue
		_shove_cooldown = SHOVE_COOLDOWN
		if _player.has_method("stagger"):
			_player.stagger(global_transform.basis * Vector3(float(v.dir) * 3.4, 0, 0))
		print("[STREET] shoved by a %s" % str(kind.id))
		return


## The whole carriageway is unsafe for sleep, as in V1: a gap can refill
## between frames.
func blocks_sleep_entry(world_position: Vector3) -> bool:
	if not is_inside_tree():
		return false
	var here := to_local(world_position)
	var site: Dictionary = data.site
	return absf(here.x) <= float(site.carriageway_x) \
			and here.z >= float(site.carriageway_z[0]) and here.z <= float(site.carriageway_z[1])


func _voice_nearest() -> void:
	if _player == null or _voices.is_empty() or not is_inside_tree():
		return
	var here := to_local(_player.global_position)
	var order := _live.duplicate()
	order.sort_custom(func(a, b): return absf(float(_world_pose(a)[0]) - here.x) < absf(float(_world_pose(b)[0]) - here.x))
	for i in _voices.size():
		var voice := _voices[i]
		if i >= order.size():
			voice.stop()
			continue
		var v: Dictionary = order[i]
		var kind: Dictionary = _kinds[int(v.kind)]
		var want: AudioStreamWAV = _streams[str(kind.voice)]
		if voice.stream != want:
			voice.stream = want
			voice.play()
		elif not voice.playing:
			voice.play()
		var pose := _world_pose(v)
		voice.position = Vector3(float(pose[0]), 1.0, float(pose[1]))
		var heavy := 0.72 if str(kind.voice) == "heavy" else 1.0
		voice.pitch_scale = clampf(float(v.speed) / 5.5, 0.5, 1.4) * heavy
		voice.volume_db = -13.0 if float(v.speed) > 0.3 else -24.0


# ---------------------------------------------------------------- review hooks

## Captures and tests place an exact street. Entries name a kind id, a lane,
## an x and optionally a speed; they are mid-block journeys. The stream stays
## frozen until `frozen` is cleared.
func stage(entries: Array) -> void:
	_live.clear()
	_cross.clear()
	for entry: Dictionary in entries:
		var index := -1
		for i in _kinds.size():
			if str(_kinds[i].id) == str(entry.id):
				index = i
		if index < 0:
			continue
		var lane_west := bool(entry.get("lane_west", true))
		var dir := -1.0 if lane_west else 1.0
		var v := _journey(index, lane_west, dir * float(entry.x))
		var kind: Dictionary = _kinds[index]
		var paint: Array = kind.paint[int(entry.get("paint", 0)) % kind.paint.size()]
		var coat: Array = data.horse_coats[int(entry.get("coat", 0)) % data.horse_coats.size()]
		v.paint = _palette(Color(paint[0], paint[1], paint[2]))
		v.coat = _palette(Color(coat[0], coat[1], coat[2]))
		v.speed = float(entry.get("speed", 0.0))
		v.cruise = maxf(float(v.cruise), float(v.speed))
		v.travel = float(entry.get("travel", 0.0))
		v.hand = str(entry.get("hand", ""))
		_live.append(v)
	frozen = true
	_write_instances()


func live_kinds() -> Array[String]:
	var ids: Array[String] = []
	for v in _live:
		ids.append(str(_kinds[int(v.kind)].id))
	return ids


func cross_count() -> int:
	return _cross.size()
