class_name OrisonV2GasService
extends Node3D
## The house gas service: the meter in the front workroom, the mains pressure
## the works deliver through the day, and the residents who turn the vestibule
## gas down and up. Design: design/V2_ENTRY_VESTIBULE_2026-10-24.md §1.
##
## Geometry (service, sealed company cock, meter, shelf, outlet) is the frame
## stock gas_service_workroom, generated by art/blender/scripts/
## build_v2_entry_vestibule.py from game/data/orison_v2/gas_service.json; this
## owner reads the same data for the dial hands, labels and rules.
##
## The company's inlet cock is lead-sealed and cannot be turned: in 1928 the
## meter cock belonged to the gas company. So the supply never fails here,
## and no pilot is ever put out by the house.
##
## The meter reads every fitting's gas_rate() through campaign time. Its
## cumulative index is the household save's mechanism record under this
## node's semantic name; it only ever counts up.
##
## A resident acts only when their own timetable puts them at the place, the
## light condition holds, and the player is out of sight range. Nothing here
## authors resident knowledge or observations.

signal manipulation_changed

const DATA := "res://data/orison_v2/gas_service.json"
const SCHEMA := "orison.v2.gas-service.v1"
const TICK := 4.0
## A sleep or skip longer than a day still burns no more than a day of gas.
const MAX_STEP_MINUTES := 1440.0

var data: Dictionary = {}
var cubic_feet := 0.0
var pressure := 1.0
var fittings: Array[OrisonV2GasFitting] = []
var hands: Array[Node3D] = []
var hand_units: Array[float] = []
var world: Node
## Tests may pin the campaign clock and the residents' places.
var clock_override: Dictionary = {}
var place_override: Dictionary = {}
var _last_minutes := NAN
var _accum := INF
var _acted: Dictionary = {}


func compose(owner_world: Node, meshes: Dictionary, lamps: Array[OrisonV2GasFitting]) -> bool:
	world = owner_world
	fittings = lamps
	data = JSON.parse_string(FileAccess.get_file_as_string(DATA))
	if data.get("schema") != SCHEMA or (data.pressure_by_hour as Array).size() != 24:
		push_error("GAS SERVICE: unknown data")
		return false
	var meter: Dictionary = data.meter
	name = str(meter.id)
	var cx := float(meter.centre_x)
	var sy := float(meter.shelf_y)
	var face := float(meter.wall_face_z) + 0.23
	# The baked service must still reach the meter: both unions on the case
	# top, the company cock on the service riser between floor and union.
	var top := sy + 0.425
	for end: Array in [data.service[-1], data.outlet[0]]:
		if absf(float(end[0]) - cx) > 0.17 or absf(float(end[1]) - top) > 0.03:
			push_error("GAS SERVICE: the baked service no longer meets the meter")
			return false
	var cock_y := float(data.company_cock_y)
	if cock_y <= float(data.service[0][1]) or cock_y >= top:
		push_error("GAS SERVICE: company cock is off its riser")
		return false
	var body := MeshInstance3D.new()
	body.name = "Stock"
	body.mesh = meshes["gas_service_workroom"]
	add_child(body)
	cubic_feet = float(meter.initial_cubic_feet)
	var ink := Color(0.10, 0.09, 0.08)
	for dial: Dictionary in meter.dials:
		var at := Vector3(cx + float(dial.offset[0]), sy + float(dial.offset[1]), face + 0.0085)
		var hand := MeshInstance3D.new()
		hand.name = "Hand%d" % int(dial.unit)
		hand.mesh = meshes["gas_meter_hand"]
		hand.position = at
		add_child(hand)
		hands.append(hand)
		hand_units.append(float(dial.unit))
		var label := Label3D.new()
		label.text = str(dial.label)
		label.font_size = 12
		label.pixel_size = 0.0004
		label.modulate = ink
		label.outline_size = 0
		label.shaded = true
		label.double_sided = false
		label.position = Vector3(at.x, at.y - float(dial.radius) - 0.009, face + 0.0068)
		add_child(label)
	_show_index()
	return true


## The index: the test dial turns once a cubic foot; each register dial once
## per ten of its unit. Adjacent dials turn opposite ways, as their gears do.
func _show_index() -> void:
	for i in hands.size():
		var unit := hand_units[i]
		var turn := fposmod(cubic_feet, 1.0) if unit <= 1.0 else fposmod(cubic_feet / unit, 10.0) / 10.0
		hands[i].rotation.z = -turn * TAU * (1.0 if i % 2 == 0 else -1.0)


func _clock_info() -> Dictionary:
	if not clock_override.is_empty():
		return clock_override
	var clock: CampaignClock = world.get("campaign_clock")
	if clock == null:
		return {"valid": false}
	var info := clock.day_info()
	info["absolute_minutes"] = clock.absolute_minutes()
	return info


func _process(delta: float) -> void:
	_accum += delta
	var info := _clock_info()
	if not bool(info.get("valid", false)):
		return
	var minutes := float(info.get("absolute_minutes", NAN))
	if is_finite(minutes):
		if is_finite(_last_minutes):
			var step := clampf(minutes - _last_minutes, 0.0, MAX_STEP_MINUTES)
			var rate := 0.0
			for fitting in fittings:
				rate += fitting.gas_rate()
			cubic_feet += rate * step / 60.0
			_show_index()
		_last_minutes = minutes
	if _accum < TICK:
		return
	_accum = 0.0
	refresh(info)


func refresh(info: Dictionary) -> void:
	var minute := float(info.get("minute_of_day", 0.0))
	var hours: Array = data.pressure_by_hour
	var hour := int(minute / 60.0) % 24
	var t := fposmod(minute, 60.0) / 60.0
	pressure = lerpf(float(hours[hour]), float(hours[(hour + 1) % 24]), t)
	for fitting in fittings:
		fitting.set_pressure(pressure)
	_residents(info)


func _residents(info: Dictionary) -> void:
	var presence: Node = world.get("resident_presence")
	var player: Node3D = world.get("player")
	for i in (data.residents as Array).size():
		var rule: Dictionary = data.residents[i]
		var fitting := _fitting(str(rule.fitting))
		if fitting == null or fitting.held():
			continue
		var stamp := "%s:%d" % [rule.resident, int(info.get("doy", 0))]
		if _acted.get(i, "") == stamp:
			continue
		var place := str(place_override.get(rule.resident, ""))
		if place.is_empty() and presence != null and presence.has_method("resolve"):
			var block: Dictionary = presence.resolve(str(rule.resident), str(info.get("day", "")),
					float(info.get("minute_of_day", 0.0)), int(info.get("doy", 1)), bool(info.get("first_sat", false)))
			place = str(block.get("place", ""))
		if place != str(rule.place):
			continue
		var night := OrisonV2StreetTraffic.lamp_factor(info, fitting.dusk, fitting.dawn)
		if (str(rule.when) == "day" and night > 0.01) or (str(rule.when) == "night" and night < 0.99):
			continue
		if player != null and player.global_position.distance_to(fitting.global_position) < float(data.player_clearance_m):
			continue
		_acted[i] = stamp
		if absf(fitting.opening - float(rule.opening)) > 0.01:
			fitting.set_opening(float(rule.opening))
			fitting.manipulation_changed.emit()


func _fitting(identity: String) -> OrisonV2GasFitting:
	for fitting in fittings:
		if str(fitting.name) == identity:
			return fitting
	return null


func mechanism_snapshot() -> Dictionary:
	return {"cubic_feet": cubic_feet}


func valid_mechanism(value: Variant) -> bool:
	return value is Dictionary and value.size() == 1 \
			and typeof(value.get("cubic_feet")) in [TYPE_FLOAT, TYPE_INT] \
			and is_finite(float(value.cubic_feet)) and float(value.cubic_feet) >= 0.0 \
			and float(value.cubic_feet) < 1.0e8


func restore_mechanism(value: Dictionary) -> void:
	if not valid_mechanism(value): return
	cubic_feet = float(value.cubic_feet)
	_show_index()
