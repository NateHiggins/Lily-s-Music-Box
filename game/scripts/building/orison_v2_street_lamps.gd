extends RefCounted
## Bishop's-crook street lamps on V2's pavements. design/V2_STREET_LAMPS_2026-10-24.md.
##
## Table and stock are generated by art/blender/scripts/build_v2_street_lamps.py.
## The authored placeholder boxes keep their collision and are hidden; their
## two authored lights move into the new globes. New posts bring their own
## light (shadowless) and a post-sized collider. The geometry source itself is
## untouched, because the paving owner pins its hash.
const DATA := "res://data/orison_v2/exterior/street_lamps.json"
const SCHEMA := "orison.v2.street-lamps.v1"


## Lights the lamps from dusk to dawn by the campaign clock, as the city did.
class LampClock extends Node:
	## How often the lamps read the campaign clock, in seconds.
	const CLOCK_PERIOD := 4.0
	var lights: Array[OmniLight3D] = []
	var globe: StandardMaterial3D
	var mantle: StandardMaterial3D
	var energy := 1.0
	var dusk: Array = []
	var dawn: Array = []
	## Tests may pin the clock instead of reading the campaign.
	var clock_override: Dictionary = {}
	var lit := -1.0
	var _accum := INF
	var ice_level := 0.0
	var pillars: Array[MeshInstance3D] = []
	var pillar_material: ShaderMaterial

	func _ready() -> void:
		add_to_group("v2_street_lamp_clocks")
		pillar_material=ShaderMaterial.new()
		pillar_material.shader=preload("res://shaders/street_ice_pillar.gdshader")
		# Reuse the actual globe transforms and clocked colour/visibility. These
		# optical quads add no lights, shadows, collision or weather authority.
		for light in lights:
			var beam := MeshInstance3D.new()
			beam.name="IcePillar"
			var quad := QuadMesh.new();quad.size=Vector2(.8,32.)
			beam.mesh=quad;beam.position.y=16.
			beam.hide()
			beam.material_override=pillar_material
			beam.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			beam.set_meta("surface_role","weather_optics")
			light.add_child(beam);pillars.append(beam)
		refresh()

	func set_ice_level(level: float) -> void:
		ice_level=clampf(level,0.,1.)
		if pillar_material!=null:
			pillar_material.set_shader_parameter("ice_level",ice_level)
		for beam in pillars:beam.visible=ice_level>.001

	func _process(delta: float) -> void:
		_accum += delta
		if _accum < CLOCK_PERIOD:
			return
		_accum = 0.0
		refresh()

	func refresh() -> void:
		var info: Dictionary = clock_override
		if info.is_empty():
			info = CampaignClock.new().day_info()
		if not bool(info.get("valid", true)):
			return
		lit = OrisonV2StreetTraffic.lamp_factor(info, dusk, dawn)
		for light in lights:
			light.visible = lit > 0.01
			light.light_energy = energy * lit
		if pillar_material!=null and not lights.is_empty():
			pillar_material.set_shader_parameter("lamp_colour",lights[0].light_color)
			pillar_material.set_shader_parameter("lamp_level",lit)
		if globe != null:
			globe.emission_energy_multiplier = float(globe.get_meta("lamp_energy", 1.0)) * lit
		if mantle != null:
			mantle.emission_energy_multiplier = float(mantle.get_meta("lamp_energy", 1.0)) * lit


static func load_table(path := DATA) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var source: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if source is not Dictionary or source.get("schema") != SCHEMA \
			or source.get("frame") != "ORISON_FRONT_DOOR_THRESHOLD":
		return {}
	for key: String in ["street_instance", "stock", "lod_stock", "lod_error_m", "globe_local", "post_radius_m", "light", "finishes", "lamps",
			"dusk", "dawn"]:
		if not source.has(key):
			return {}
	if float(source.lod_error_m) <= 0.:
		return {}
	if (source.dusk as Array).size() != 12 or (source.dawn as Array).size() != 12:
		return {}
	# Finish records go to the shared stock binder; refuse a malformed one here.
	for finish: Dictionary in source.finishes:
		for key: String in ["id", "catalog_key", "tint", "normal", "roughness"]:
			if not finish.has(key):
				return {}
		if finish.has("emission") and (finish.emission as Array).size() != 4:
			return {}
	return source


static func _lamp_meshes(data: Dictionary, materials: Dictionary) -> Dictionary:
	# Traffic's stock assembler intentionally discards importer LODs. Preserve
	# its retained signal-box stock and append complete plain-lamp bodies here.
	var meshes := OrisonV2StreetTraffic.stock_meshes(str(data.stock), materials)
	var low := OrisonV2StreetTraffic.stock_meshes(str(data.lod_stock), materials)
	assert(meshes.has("bishops_crook") and low.has("bishops_crook_lod1"))
	var near: ArrayMesh = meshes.bishops_crook
	var far: ArrayMesh = low.bishops_crook_lod1
	assert(near.get_surface_count() == 6 and far.get_surface_count() == 6)
	var lower_surfaces := {}
	for surface in far.get_surface_count():
		lower_surfaces[far.surface_get_material(surface).get_meta("v2_street_lamp_finish")] = surface
	var result := ArrayMesh.new()
	for surface in near.get_surface_count():
		var material := near.surface_get_material(surface)
		var alias: String = material.get_meta("v2_street_lamp_finish")
		assert(lower_surfaces.has(alias))
		var arrays := near.surface_get_arrays(surface)
		var replacement := far.surface_get_arrays(int(lower_surfaces[alias]))
		var offset: int = arrays[Mesh.ARRAY_VERTEX].size()
		for channel: int in [Mesh.ARRAY_VERTEX, Mesh.ARRAY_NORMAL, Mesh.ARRAY_TANGENT, Mesh.ARRAY_TEX_UV]:
			var values: Variant = arrays[channel]
			values.append_array(replacement[channel])
			arrays[channel] = values
		var indices: PackedInt32Array = replacement[Mesh.ARRAY_INDEX].duplicate()
		assert(indices.size() < arrays[Mesh.ARRAY_INDEX].size())
		for index in indices.size(): indices[index] += offset
		result.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {float(data.lod_error_m): indices})
		result.surface_set_material(surface, material)
	meshes.bishops_crook = result
	return meshes


static func mount(world: Node) -> Node3D:
	var data := load_table()
	if data.is_empty():
		return null
	var street: Node3D = world.exterior_cell.instance_node(str(data.street_instance))
	if street == null:
		return null
	var materials := {}
	for finish: Dictionary in data.finishes:
		var material := OrisonV2StreetTraffic.stock_material(finish)
		if str(finish.id) == "gas_glass":
			material = preload("res://scripts/building/orison_v2_expressive_glass.gd").make(str(finish.catalog_key))
			material.normal_scale = float(finish.normal)
			material.roughness = float(finish.roughness)
			material.set_meta("v2_surface_stock", str(finish.catalog_key))
		material.metallic = float(finish.get("metallic", material.metallic))
		material.set_meta("v2_street_lamp_finish", str(finish.id))
		materials[str(finish.id)] = material
	var meshes := _lamp_meshes(data, materials)
	var lights := {}
	for light: OmniLight3D in street.find_children("*", "OmniLight3D", true, false):
		lights[str(light.get_meta("authored_record_id", ""))] = light
	var root := Node3D.new()
	root.name = "StreetLamps"
	var clock := LampClock.new()
	clock.name = "LampClock"
	clock.globe = materials.get("globe_lit")
	clock.mantle = materials.get("gas_mantle")
	clock.energy = float(data.light.energy)
	clock.dusk = data.dusk
	clock.dawn = data.dawn
	root.add_child(clock)
	var globe: Array = data.globe_local
	var colour: Array = data.light.color_rgb
	for lamp: Dictionary in data.lamps:
		if not meshes.has(str(lamp.stock)):
			root.free()
			return null
		var at: Array = lamp.at
		var frame := Transform3D(Basis(Vector3.UP, deg_to_rad(float(lamp.yaw_degrees))),
				Vector3(at[0], at[1], at[2]))
		var post := MeshInstance3D.new()
		post.name = str(lamp.id)
		post.mesh = meshes[str(lamp.stock)]
		post.transform = frame
		post.set_meta("source_record", str(lamp.id))
		root.add_child(post)
		var originals: Array[MeshInstance3D] = []
		for id: String in lamp.replaces:
			var draw := preload("res://scripts/building/orison_v2_bodega_frontage.gd").authored_mesh(street, id)
			if draw == null:
				root.free()
				return null
			originals.append(draw)
		for draw in originals:
			draw.hide()
		post.set_meta("original_draws", originals)
		var body := StaticBody3D.new()
		body.name = "Collision"
		var shape := CollisionShape3D.new()
		var cylinder := CylinderShape3D.new()
		cylinder.radius = float(data.post_radius_m)
		cylinder.height = 2.4
		shape.shape = cylinder
		shape.position.y = 1.2
		body.add_child(shape)
		post.add_child(body)
		var light: OmniLight3D = lights.get(str(lamp.authored_light), null)
		if light == null:
			if not str(lamp.authored_light).is_empty():
				root.free()
				return null
			light = OmniLight3D.new()
			light.name = "LampPool"
			light.set_meta("authored_record_id", str(lamp.id) + "_pool")
			root.add_child(light)
		# The lamp is in the globe now, half a metre higher and out over the
		# gutter, so its pool reaches further at the same apparent warmth.
		var in_street := frame * Vector3(globe[0], globe[1], globe[2])
		if light.get_parent() == root:
			light.position = in_street
		else:
			light.global_position = street.to_global(in_street)
		light.light_color = Color(colour[0], colour[1], colour[2])
		light.light_energy = float(data.light.energy)
		light.omni_range = float(data.light.range_m)
		light.shadow_enabled = bool(lamp.shadows)
		clock.lights.append(light)
	street.add_child(root)
	clock.refresh()
	return root
