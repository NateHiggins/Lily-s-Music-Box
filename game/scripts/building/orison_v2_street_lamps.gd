extends RefCounted
## Bishop's-crook street lamps on V2's pavements. design/V2_STREET_LAMPS_2026-10-24.md.
##
## Table and stock are generated by art/blender/scripts/build_v2_street_lamps.py.
## The authored placeholder boxes keep their collision and are hidden; their
## two authored lights move into the new globes. New posts bring their own
## light (shadowless) and a post-sized collider. The geometry source itself is
## untouched, because the paving owner pins its hash.
const DATA := "res://data/orison_v2/exterior/street_lamps.json"
const SCHEMA := "orison.v2.street-lamps.v1"


static func load_table(path := DATA) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var source: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if source is not Dictionary or source.get("schema") != SCHEMA \
			or source.get("frame") != "ORISON_FRONT_DOOR_THRESHOLD":
		return {}
	for key: String in ["street_instance", "stock", "globe_local", "post_radius_m", "light", "finishes", "lamps"]:
		if not source.has(key):
			return {}
	# Finish records go to the shared stock binder; refuse a malformed one here.
	for finish: Dictionary in source.finishes:
		for key: String in ["id", "catalog_key", "tint", "normal", "roughness"]:
			if not finish.has(key):
				return {}
		if finish.has("emission") and (finish.emission as Array).size() != 4:
			return {}
	return source


static func mount(world: Node) -> Node3D:
	var data := load_table()
	if data.is_empty():
		return null
	var street: Node3D = world.exterior_cell.instance_node(str(data.street_instance))
	if street == null:
		return null
	var materials := {}
	for finish: Dictionary in data.finishes:
		materials[str(finish.id)] = OrisonV2StreetTraffic.stock_material(finish)
	var meshes := OrisonV2StreetTraffic.stock_meshes(str(data.stock), materials)
	var lights := {}
	for light: OmniLight3D in street.find_children("*", "OmniLight3D", true, false):
		lights[str(light.get_meta("authored_record_id", ""))] = light
	var root := Node3D.new()
	root.name = "StreetLamps"
	var globe: Array = data.globe_local
	var colour: Array = data.light.color_rgb
	for lamp: Dictionary in data.lamps:
		if not meshes.has(str(lamp.stock)):
			root.free()
			return null
		var at: Array = lamp.at
		var frame := Transform3D(Basis(Vector3.UP, deg_to_rad(float(lamp.yaw_degrees))),
				Vector3(at[0], at[1], at[2]))
		var post := MeshInstance3D.new()
		post.name = str(lamp.id)
		post.mesh = meshes[str(lamp.stock)]
		post.transform = frame
		post.set_meta("source_record", str(lamp.id))
		root.add_child(post)
		var originals: Array[MeshInstance3D] = []
		for id: String in lamp.replaces:
			var draw := preload("res://scripts/building/orison_v2_bodega_frontage.gd").authored_mesh(street, id)
			if draw == null:
				root.free()
				return null
			originals.append(draw)
		for draw in originals:
			draw.hide()
		post.set_meta("original_draws", originals)
		var body := StaticBody3D.new()
		body.name = "Collision"
		var shape := CollisionShape3D.new()
		var cylinder := CylinderShape3D.new()
		cylinder.radius = float(data.post_radius_m)
		cylinder.height = 2.4
		shape.shape = cylinder
		shape.position.y = 1.2
		body.add_child(shape)
		post.add_child(body)
		var light: OmniLight3D = lights.get(str(lamp.authored_light), null)
		if light == null:
			if not str(lamp.authored_light).is_empty():
				root.free()
				return null
			light = OmniLight3D.new()
			light.name = "LampPool"
			light.set_meta("authored_record_id", str(lamp.id) + "_pool")
			root.add_child(light)
		# The lamp is in the globe now, half a metre higher and out over the
		# gutter, so its pool reaches further at the same apparent warmth.
		var in_street := frame * Vector3(globe[0], globe[1], globe[2])
		if light.get_parent() == root:
			light.position = in_street
		else:
			light.global_position = street.to_global(in_street)
		light.light_color = Color(colour[0], colour[1], colour[2])
		light.light_energy = float(data.light.energy)
		light.omni_range = float(data.light.range_m)
		light.shadow_enabled = bool(lamp.shadows)
	street.add_child(root)
	return root
