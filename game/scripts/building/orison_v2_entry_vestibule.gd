class_name OrisonV2EntryVestibule
extends Node3D
## The V2 front entrance's gas lights and the dress of the entry vestibule.
## Design: design/V2_ENTRY_VESTIBULE_2026-10-24.md.
##
## Stock and finishes are generated by art/blender/scripts/build_v2_entry_vestibule.py;
## placements and copy are game/data/orison_v2/entry_vestibule.json. This owner
## only reads them. It is a child of the blockout root, so every coordinate is
## the blockout frame. Lettering is Label3D (RUL-008): the tenant names come
## from the resident schedules, one notice is the mail catalogue's own copy.
## The plaque keeps BuildingEntrySign's legend and inspection on native stock.
##
## No gameplay authority: the street door, keys, heat and the house listening
## network keep their owners. The radiator is dress, not on the heating graph.

const DATA := "res://data/orison_v2/entry_vestibule.json"
const STOCK := "res://data/orison_v2/entry_vestibule_stock.json"
const Traffic := preload("res://scripts/building/orison_v2_street_traffic.gd")
## Into-room yaw for each vestibule wall: local +Z leaves the wall.
const WALL_YAW := {"west": PI * 0.5, "east": -PI * 0.5, "north": PI}

var data: Dictionary = {}
var meshes: Dictionary = {}
var lamps: Array[OmniLight3D] = []


static func mount(world: Node) -> OrisonV2EntryVestibule:
	var vestibule := OrisonV2EntryVestibule.new()
	vestibule.name = "EntryVestibule"
	var root: Node3D = world.adapter.root
	root.add_child(vestibule)
	if not vestibule.compose(root):
		root.remove_child(vestibule)
		vestibule.free()
		return null
	return vestibule


func compose(root: Node3D) -> bool:
	data = JSON.parse_string(FileAccess.get_file_as_string(DATA))
	var stock: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(STOCK))
	if data.get("schema") != "orison.v2.entry-vestibule.v1" \
			or stock.get("schema") != "orison.v2.entry-vestibule-stock.v1":
		push_error("ENTRY VESTIBULE: unknown data schema")
		return false
	var materials := {}
	for finish: Dictionary in stock.finishes:
		# Catalogue stock with its relief, roughness, tint and any glow.
		if not MatLib.SETS.has(str(finish.catalog_key)) or float(finish.normal) <= 0.0 				or float(finish.roughness) <= 0.0 or (finish.tint as Array).size() != 4 				or (finish.has("emission") and (finish.emission as Array).size() != 4):
			push_error("ENTRY VESTIBULE: malformed finish " + str(finish.id))
			return false
		materials[str(finish.id)] = Traffic.stock_material(finish)
	meshes = Traffic.stock_meshes(str(stock.stock), materials)
	for id: String in stock.stocks:
		if not meshes.has(id):
			push_error("ENTRY VESTIBULE: stock missing " + id)
			return false
	var faces: Dictionary = data.wall_faces
	for row: Dictionary in data.fittings:
		var node := Node3D.new()
		node.name = str(row.id)
		if row.has("floor"):
			node.position = Vector3(float(row.floor[0]), 0.0, float(row.floor[1]))
		elif str(row.wall) == "north":
			node.position = Vector3(float(row.along), float(row.height), float(faces.north))
		else:
			node.position = Vector3(float(faces[row.wall]), float(row.height), float(row.along))
		if row.has("wall"):
			node.rotation.y = WALL_YAW[str(row.wall)]
		add_child(node)
		if str(row.stock) == "bronze_plaque":
			_plaque(node, float(row.get("scale", 1.0)))
		else:
			_draw(node, str(row.stock))
	_directory(get_node("Directory") as Node3D)
	for notice: Dictionary in data.notices:
		_notice(get_node(str(notice.fitting)) as Node3D, notice)
	_radiator_body(get_node("Radiator") as Node3D)
	return _lamps(root)


func _draw(parent: Node3D, stock: String) -> MeshInstance3D:
	var draw := MeshInstance3D.new()
	draw.name = "Stock"
	draw.mesh = meshes[stock]
	parent.add_child(draw)
	return draw


## The original plaque's legend and inspection, on the native bronze tablet.
## The tablet's back sits on the wall; its legend takes light, never gives it.
func _plaque(parent: Node3D, plaque_scale: float) -> void:
	var sign := BuildingEntrySign.new()
	sign.scale = Vector3.ONE * plaque_scale
	sign.position.z = 0.0225 * plaque_scale
	parent.add_child(sign)
	for child: Node in sign.get_children():
		if child is MeshInstance3D:
			sign.remove_child(child)
			child.free()
		elif child is Label3D:
			(child as Label3D).shaded = true
	_draw(sign, "bronze_plaque")


func _label(parent: Node3D, text: String, at: Vector3, size: int, colour: Color,
		align := HORIZONTAL_ALIGNMENT_LEFT, wrap_m := 0.0) -> Label3D:
	var label := Label3D.new()
	label.text = text
	label.font_size = size
	label.pixel_size = 0.0008
	label.modulate = colour
	label.outline_size = 0
	label.shaded = true
	label.double_sided = false
	label.horizontal_alignment = align
	label.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	label.position = at
	if wrap_m > 0.0:
		label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		label.width = wrap_m / label.pixel_size
	parent.add_child(label)
	return label


## Felt changeable letters, one row per unit, from the resident schedules.
## The player's own unit has a row and no name yet.
func _directory(board: Node3D) -> void:
	var spec: Dictionary = data.directory
	_label(board, str(spec.header), Vector3(0, 0.392, 0.0165), 22, Color(0.16, 0.10, 0.04),
			HORIZONTAL_ALIGNMENT_CENTER)
	var schedules: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/resident_schedules.json"))
	var letters := {}
	for row: Dictionary in spec.names:
		letters[str(row.resident)] = str(row.letters)
	var units: Dictionary = {DoorKeyring.player_unit(): []}
	for id: String in schedules.residents:
		var unit := str(schedules.residents[id].unit)
		if not units.has(unit):
			units[unit] = []
		units[unit].append(str(letters.get(id, _letters(id))))
	var order: Array = units.keys()
	order.sort()
	var names := Node3D.new()
	names.name = "DirectoryNames"
	board.add_child(names)
	var white := Color(0.86, 0.84, 0.78)
	for i in order.size():
		var y := float(spec.first_row) - float(spec.row_pitch) * i
		var row := Node3D.new()
		row.name = "Unit" + str(order[i])
		names.add_child(row)
		_label(row, str(order[i]), Vector3(-0.245, y, 0.021), 22, white)
		_label(row, "  /  ".join(PackedStringArray(units[order[i]])), Vector3(-0.165, y, 0.021), 22, white)


## evelyn_marsh -> E. MARSH, the way a superintendent sets felt letters.
static func _letters(id: String) -> String:
	var parts := id.split("_")
	return (parts[0].left(1) + ". " + " ".join(parts.slice(1))).to_upper()


func _notice(frame: Node3D, spec: Dictionary) -> void:
	var title := str(spec.get("title", ""))
	var body := str(spec.get("body", ""))
	if spec.has("mail"):
		var catalog: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/mail_catalog.json"))
		for row: Dictionary in catalog.deliveries:
			if str(row.id) == str(spec.mail):
				title = str(row.title)
				body = str(row.body)
	var ink := Color(0.10, 0.09, 0.08)
	_label(frame, title, Vector3(0, 0.175, 0.009), 15, ink, HORIZONTAL_ALIGNMENT_CENTER, 0.26)
	_label(frame, body, Vector3(-0.13, 0.13, 0.009), 11, ink, HORIZONTAL_ALIGNMENT_LEFT, 0.26)


func _radiator_body(radiator: Node3D) -> void:
	var body := StaticBody3D.new()
	body.name = "RadiatorCollision"
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(0.68, 0.70, 0.18)
	shape.shape = box
	shape.position = Vector3(-0.035, 0.35, 0.10)
	body.add_child(shape)
	radiator.add_child(body)


## Gas, not electric: light carries no signal, so it never advanced (Bible
## VIII.2). An iron lantern on the west pier outside, under the dark marquee,
## and an inverted-mantle bracket over the vestibule's inner doorway, fed by
## the surface-run supply. Its light reaches the street through the door glass.
func _lamps(root: Node3D) -> bool:
	var facade := root.get_node_or_null("FrontFacade") as Node3D
	if facade == null:
		push_error("ENTRY VESTIBULE: the front facade must mount first")
		return false
	# The supply stock was generated from this run: refuse a placement the
	# baked pipe could no longer reach (a riser off the wall, a bracket above
	# the run under the cornice).
	var gas: Dictionary = data.gas
	if absf(float(gas.riser)) >= float(data.wall_faces.east):
		push_error("ENTRY VESTIBULE: gas riser is off the north wall")
		return false
	for row: Dictionary in data.lamps.fittings:
		if row.has("wall") and float(row.height) >= float(gas.run_height):
			push_error("ENTRY VESTIBULE: %s sits above its gas run; rebuild the stock" % row.id)
			return false
	for stock: String in data.frame_stocks:
		var run := Node3D.new()
		run.name = "GasSupply"
		add_child(run)
		_draw(run, stock)
	for row: Dictionary in data.lamps.fittings:
		var mount_point := Node3D.new()
		mount_point.name = str(row.id)
		add_child(mount_point)
		if row.has("facade_point"):
			var at: Array = row.facade_point
			mount_point.global_transform = facade.global_transform * Transform3D(Basis.IDENTITY,
					Vector3(float(at[0]), float(at[1]), float(at[2])))
		else:
			mount_point.position = Vector3(float(row.along), float(row.height), float(data.wall_faces[row.wall]))
			mount_point.rotation.y = WALL_YAW[str(row.wall)]
		# Etched glass diffuses; the fitting must not cut a hard cone of
		# shadow out of its own light on the wall behind it.
		_draw(mount_point, str(row.stock)).cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		var glow: Dictionary = row.light
		var flame: Array = row.flame
		var light := OmniLight3D.new()
		light.name = "Mantle"
		light.position = Vector3(float(flame[0]), float(flame[1]), float(flame[2]))
		light.light_color = Color(float(glow.color[0]), float(glow.color[1]), float(glow.color[2]))
		light.light_energy = float(glow.energy)
		light.omni_range = float(glow.range)
		light.omni_attenuation = float(glow.attenuation)
		light.shadow_enabled = true
		light.set_meta("base_energy", light.light_energy)
		mount_point.add_child(light)
		lamps.append(light)
	return true


## A mantle on house gas never quite holds still: a slow breathing with the
## supply pressure and a faint quick waver, a few percent either way.
func _process(_delta: float) -> void:
	var t := Time.get_ticks_msec() * 0.001
	for i in lamps.size():
		var phase := i * 2.3
		var breath := 0.03 * sin(t * 0.9 + phase) + 0.015 * sin(t * 6.7 + phase * 1.7)
		lamps[i].light_energy = float(lamps[i].get_meta("base_energy")) * (1.0 + breath)
