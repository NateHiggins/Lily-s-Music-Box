+func _v2_vec(value: Vector3) -> Array:
+	return [value.x, value.y, value.z]
+
+func _v2_sightline(from: Vector3, target: Vector3) -> Dictionary:
+	var query := PhysicsRayQueryParameters3D.create(from, target)
+	query.collide_with_bodies = true
+	query.collide_with_areas = false
+	query.hit_from_inside = true
+	query.exclude = [player.get_rid()]
+	var hit: Dictionary = camera.get_world_3d().direct_space_state.intersect_ray(query)
+	var collider := hit.get("collider") as Node
+	return {"from": _v2_vec(from), "to": _v2_vec(target), "length_m": from.distance_to(target),
+		"blocked": not hit.is_empty(), "collider_path": str(collider.get_path()) if collider != null else "",
+		"collider_class": collider.get_class() if collider != null else "",
+		"hit_position": _v2_vec(hit.position) if not hit.is_empty() else [],
+		"hit_normal": _v2_vec(hit.normal) if not hit.is_empty() else [],
+		"collide_with_bodies": true, "collide_with_areas": false, "hit_from_inside": true,
+		"excluded_player_rid_only": true, "scope": "physical obstruction only; SignalScope need not be a collider"}
+
+func _v2_geometry_witness(mesh: MeshInstance3D) -> Dictionary:
+	var bounds: AABB = mesh.global_transform * mesh.get_aabb()
+	var material: Material = mesh.get_active_material(0) if mesh.mesh != null and mesh.mesh.get_surface_count() > 0 else null
+	var collision_paths: Array = []
+	for body in mesh.find_children("*", "CollisionObject3D", true, false):
+		collision_paths.append(str(body.get_path()))
+	return {"path": str(mesh.get_path()), "position": _v2_vec(mesh.global_position),
+		"world_bounds_position": _v2_vec(bounds.position), "world_bounds_size": _v2_vec(bounds.size),
+		"visible_in_tree": mesh.is_visible_in_tree(), "purpose": str(mesh.get_meta("purpose", "")),
+		"camera_inside_world_bounds": bounds.has_point(camera.global_position),
+		"camera_cull_mask_overlap": (mesh.layers & camera.cull_mask) != 0,
+		"material_class": material.get_class() if material != null else "",
+		"transparency": int((material as BaseMaterial3D).transparency) if material is BaseMaterial3D else -1,
+		"albedo_alpha": (material as BaseMaterial3D).albedo_color.a if material is BaseMaterial3D else -1.0,
+		"collision_descendants": collision_paths}
+
