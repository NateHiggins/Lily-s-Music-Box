+				or cursor.is_in_group("resident_placeholders") or cursor.is_in_group("animated_residents") \
+				or str(cursor.name).begins_with("NPC_"):
+			return false
+		if cursor == scope:
+			return true
+		cursor = cursor.get_parent()
+	return false
 
 
