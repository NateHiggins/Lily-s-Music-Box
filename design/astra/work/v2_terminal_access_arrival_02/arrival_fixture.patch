+func _observe_deferred_arrival() -> Dictionary:
+	var before: Vector3 = player.global_position
+	var expected := Vector3(-3.6, 0.1, 24.72)
+	var phase_before: String = world.first_shift_director.ritual_phase()
+	var waited := 0
+	while waited < 120:
+		await get_tree().process_frame
+		waited += 1
+		if _arrival_pose_matches(expected): break
+	var observed: bool = _arrival_pose_matches(expected)
+	# Additional process frames allow the already scheduled callback to settle;
+	# this is a witnessed one-shot placement, not general world readiness.
+	await _frames(2)
+	var after: Vector3 = player.global_position
+	var phase_after: String = world.first_shift_director.ritual_phase()
+	var settled: bool = observed and _arrival_pose_matches(expected) \
+		and not before.is_equal_approx(expected) and phase_after == phase_before \
+		and phase_after == FirstShiftDirector.PHASE_COMPLETE
+	return {"before_position": _vec(before), "position": _vec(after),
+		"camera_position": _vec(player.camera.global_position),
+		"velocity": _vec(player.velocity), "yaw": player.rotation.y,
+		"camera_local_rotation": _vec(player.camera.rotation),
+		"phase_before": phase_before, "phase_after": phase_after,
+		"waited_process_frames": waited, "stable_process_frames": 2,
+		"observed": observed, "settled": settled,
+		"director_owns_world": world.first_shift_director.building == world,
+		"intro_complete": bool(RealityState.data.get("intro_complete", false)),
+		"noclip": player.noclip, "call_locked": player.call_locked,
+		"collision_layer": player.collision_layer, "collision_mask": player.collision_mask}
+
+func _arrival_pose_matches(expected: Vector3) -> bool:
+	var target := Vector3(0.0, 2.15, 9.82)
+	var flat: Vector3 = target - expected
+	var expected_yaw: float = atan2(-flat.x, -flat.z)
+	return world.first_shift_director != null and world.first_shift_director.building == world \
+		and bool(RealityState.data.get("intro_complete", false)) \
+		and player.global_position.is_equal_approx(expected) \
+		and player.camera.global_position.is_equal_approx(expected + Vector3.UP * player.STANDING_EYE) \
+		and player.camera.rotation.is_equal_approx(Vector3.ZERO) \
+		and is_equal_approx(player.rotation.y, expected_yaw) \
+		and player.velocity.is_zero_approx() and not player.noclip and not player.call_locked \
+		and player.collision_layer == 1 and player.collision_mask == 1
+
+func _at_operator(ray: Dictionary, operator: Node3D) -> bool:
+	var expected_eye: Vector3 = operator.global_position + Vector3.UP * player.STANDING_EYE
+	return player.global_position.is_equal_approx(operator.global_position) \
+		and player.camera.global_position.is_equal_approx(expected_eye) \
+		and Vector3(ray.from[0], ray.from[1], ray.from[2]).is_equal_approx(expected_eye) \
+		and not player.is_physics_processing()
+
